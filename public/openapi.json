  "components": {
    "schemas": {
      "UserInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 50
          }
        }
      },
      "ProductInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 5000
          },
          "price": {
            "type": "string",
            "pattern": "^[0-9]{1,10}(\\.[0-9]{1,2})?$",
            "example": "199.99",
            "description": "Exact non-negative decimal, sent as a string."
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "default": 0
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 50
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "example": "1"
          },
          "created_at": {
            "type": "string",
            "description": "PostgreSQL timestamp text"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 5000
          },
          "price": {
            "type": "string",
            "pattern": "^[0-9]{1,10}(\\.[0-9]{1,2})?$",
            "example": "199.99",
            "description": "Exact non-negative decimal, sent as a string."
          },
          "stock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "default": 0
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "example": "1"
          },
          "created_at": {
            "type": "string",
            "description": "PostgreSQL timestamp text"
          }
        }
      }
    }
  }
}
